#Declaração de variáveis
x:int=0
y:int=0

#Início
x=int(input("O valor de X: "))
y=int(input("O valor de Y: "))
soma=0
mult=0
if(x>y and y%2==0):
    for i in range(y+1,x+1,2):
        soma=soma+i
    print("O valor da somatória é:",soma)
    
elif (x>y and y%2!=0):
    for i in range(y,x+1,2):
        soma=soma+i
    print("O valor da somatória é:",soma)
    
elif (y>x and x%2==0):
    for i in range (x+1,y+1,2):
        soma=soma+i
    print("O valor da somatória é:",soma)
    
else:
    for i in range (x,y+1,2):
        soma=soma+i
    print("O valor da somatória é:",soma)
    
#Fim
